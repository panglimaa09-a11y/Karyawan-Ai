DATABASE_URL=postgresql://kai_user:change-me@127.0.0.1:5432/karyawan_ai
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KAI_ENCRYPTION_KEY=replace_with_64_hex_characters
# At least 24 random characters; keep server-side only.
KAI_ADMIN_TOKEN=replace_with_long_random_secret
# Optional hosted PostgreSQL TLS mode
# PGSSLMODE=require
# Workspace terisolasi untuk tool shell/filesystem (default: ./workspace)
# KAI_WORKSPACE=/data/kai-workspace
# Token GitHub server-side untuk push (jangan taruh di UI); push tetap butuh approval
# GITHUB_TOKEN=ghp_replace_me
